/*
  Styles for the "{{.Type}}" card. Use the theme variables so the card follows the admin Theme:
  --wb-text --wb-text-muted --wb-text-faint --wb-accent --wb-positive --wb-negative --wb-surface --wb-border ...

  The card is a size container named "card": query its own size, not the screen's.
  Make sure it still looks right at 1x1, 2x1, 1x2 and 2x2.
*/
.{{.Type}}-value {
  font-size: 2.2em; /* fitText() shrinks it when it would overflow */
  font-weight: 700;
  line-height: 1.1;
  color: var(--wb-text);
  white-space: nowrap;
}

/* Tall enough for extras: */
@container card (min-height: 140px) {
  /* .{{.Type}}-extra { display: block; } */
}

/* Wide and short: lay things out side by side. */
@container card (min-aspect-ratio: 2/1) {
  /* ... */
}

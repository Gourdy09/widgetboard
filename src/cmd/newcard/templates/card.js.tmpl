// {{.Label}} card. Generated by `go run ./cmd/newcard {{.Type}}`.
//
// A card type is three things:
//   meta    - what the layout engine and the admin editor need to know (sizes, defaults, option fields)
//   render  - draws the card into its slots and returns an optional cleanup function
//   css     - styles, in static/css/cards/{{.Type}}.css
//
// The card must look right at EVERY size from 1x1 up. Do that with container queries in the css file
// (the card is a size container named "card") and fitText() for numbers that must never overflow.
// Hidden / collapsed elements arrive as missing slots, so always check `if (slots.x)`.
import { fitText } from "../utils/fitText.js";

export const type = "{{.Type}}";
export const css = "/static/css/cards/{{.Type}}.css";

export const meta = {
  label: "{{.Label}}",
  description: "TODO: one line shown in the widget palette.",
  size: {
    default: { col_span: 2, row_span: 2 },
    min: { col_span: 1, row_span: 1 }, // keep 1x1 unless the card truly cannot shrink
    // max: omitted = as big as the grid
  },
  minRefreshMs: 5000, // lowest refresh interval the editor will accept
  defaults: {
    title: "{{.Label}}",
    refreshMs: 30000,
    params: { text: "Hello" },
  },
  // Options shown in the admin editor. Field types: string | text | number | select | combobox | boolean
  params: {
    text: { type: "string", label: "Text" },
    // example: unit: { type: "select", label: "Unit", options: ["metric", "imperial"] },
  },
  // Short text shown on the block in the admin grid.
  summary: (card) => card.params?.text ?? "",
};

export function render(slots, cardData) {
  if (slots.title) slots.title.textContent = cardData.title;
  if (slots.subtitle) slots.subtitle.textContent = cardData.subtitle;
  if (slots.footer) slots.footer.textContent = cardData.footer;

  const value = document.createElement("div");
  value.className = "{{.Type}}-value";
  slots.main?.append(value);
  const fit = slots.main ? fitText(value, { container: slots.main }) : null;

  async function update() {
    // TODO: fetch your data here (e.g. fetch(cardData.apiUrl || "/api/...")) and handle errors.
    value.textContent = cardData.params.text;
    fit?.update();
  }

  update();
  const timer = setInterval(update, cardData.refreshMs);

  // Cleanup: called when the card is edited, moved to another type or removed.
  return () => {
    clearInterval(timer);
    fit?.destroy();
  };
}
